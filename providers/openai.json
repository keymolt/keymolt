{
  "detect": {"name": "OPENAI|OAI", "value": "^sk-"},
  "create": {
    "method": "POST",
    "url": "https://api.openai.com/v1/organization/projects/{{openai_project}}/service_accounts",
    "headers": {"Authorization": "Bearer {{cred:openai_admin}}", "Content-Type": "application/json"},
    "body": {"name": "keymolt-{{ts}}"},
    "value": "api_key.value",
    "id": "id"
  },
  "verify": {
    "url": "https://api.openai.com/v1/models",
    "headers": {"Authorization": "Bearer {{new}}"}
  },
  "revoke": {
    "method": "DELETE",
    "url": "https://api.openai.com/v1/organization/projects/{{openai_project}}/service_accounts/{{old_id}}",
    "headers": {"Authorization": "Bearer {{cred:openai_admin}}"}
  }
}
